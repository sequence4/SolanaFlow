{
  "name": "landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:e2e": "bash ./scripts/e2e-env.sh && next build",
    "build:prod": "next build",
    "export": "next export -o out",
    "start": "node .next/standalone/server.js",
    "start:prod": "PORT=3000 node .next/standalone/server.js",
    "serve:prod": "PORT=3000 pnpm run start:prod",
    "db:smoke": "bash landing/scripts/smoke/db-writer-only.sh",
    "deps:update": "pnpm up --latest",
    "deps:audit": "pnpm audit --prod --audit-level high",
    "security:scan": "gitleaks detect --verbose || true",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "test": "dotenv -e .env.test -- jest",
    "test:watch": "jest --watchAll",
    "test:api": "cross-env NODE_ENV=test jest src/__tests__/api/",
    "test:e2e": "cross-env E2E=1 start-server-and-test \"pnpm run build:e2e && NODE_ENV=production PORT=3000 pnpm run start:prod\" http://127.0.0.1:3000 \"playwright test\"",
    "e2e": "pnpm run test:e2e",
    "test:cov": "dotenv -e .env.test -- jest --coverage --coverageThreshold '{\"global\":{\"branches\":80,\"lines\":80}}'",
    "lighthouse:test": "cross-env E2E=1 start-server-and-test \"pnpm run build:e2e && PORT=3000 pnpm run start:prod\" http://127.0.0.1:3000 \"npx lhci autorun --config=./lighthouserc.js\"",
    "lhci:quick": "LHCI_DEV=1 NUMBER_OF_RUNS=1 pnpm dlx wait-on http://127.0.0.1:3000 && lhci autorun --quiet",
    "lighthouse:quick": "E2E=1 pnpm run build:prod && start-server-and-test \"PORT=3000 pnpm run start:prod\" http://127.0.0.1:3000 \"pnpm run lhci:quick\"",
    "ci": "pnpm type-check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@jest/globals": "^29.7.0",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-scroll-area": "^1.2.8",
    "@radix-ui/react-tabs": "^1.1.11",
    "@tailwindcss/container-queries": "^0.1.1",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.8",
    "@xyflow/react": "^12.4.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.479.0",
    "next": "^15.2.3",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "styled-jsx": "^5.1.2",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.41.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testcontainers/postgresql": "^10.25.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^29.5.12",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^20",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.3",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^12.6.0",
    "lighthouse-ci": "^1.13.1",
    "npm-run-all": "^4.1.5",
    "playwright": "^1.52.0",
    "postcss": "^8.5.3",
    "process": "^0.11.10",
    "serve": "^14.2.4",
    "start-server-and-test": "^2.0.11",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-scrollbar": "^0.1.0",
    "ts-jest": "^29.1.2",
    "ts-node": "10.9.1",
    "wait-on": "^8.0.3",
    "whatwg-fetch": "^3.6.20"
  }
}
