{
  "name": "landing",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:prod": "next build",
    "export": "next export -o out",
    "start": "next start",
    "start:prod": "next start -p 3000",
    "type-check": "tsc --noEmit",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "test:api": "cross-env NODE_ENV=test jest src/__tests__/api/",
    "test:e2e": "pnpm run build:prod && PLAYWRIGHT_SERVER=1 pnpm run start:prod & wait-on http://127.0.0.1:3000 && playwright test && pkill -f \"next start -p 3000\"",
    "test:cov": "jest --coverage --coverageThreshold '{\"global\":{\"branches\":80,\"lines\":80}}'",
    "lighthouse:test": "wait-on http://127.0.0.1:3000 && npx lhci autorun --config=./lighthouserc.js",
    "ci": "pnpm type-check && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@jest/globals": "^29.7.0",
    "@radix-ui/react-label": "^2.0.2",
    "@xyflow/react": "^12.4.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.479.0",
    "next": "^15.2.3",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.5.0",
    "styled-jsx": "^5.1.2",
    "tailwind-merge": "^2.2.2",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.41.1",
    "@tailwindcss/postcss": "^4.0.15",
    "@testcontainers/postgresql": "^10.25.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/canvas-confetti": "^1.9.0",
    "@types/jest": "^29.5.12",
    "@types/jest-axe": "^3.5.9",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "canvas-confetti": "^1.9.3",
    "cross-env": "^7.0.3",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-axe": "^8.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "lighthouse": "^12.6.0",
    "lighthouse-ci": "^1.13.1",
    "playwright": "^1.52.0",
    "postcss": "^8.5.3",
    "serve": "^14.2.4",
    "supertest": "^7.1.0",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "ts-jest": "^29.1.2",
    "ts-node": "10.9.1",
    "wait-on": "^8.0.3",
    "whatwg-fetch": "^3.6.20"
  }
}
