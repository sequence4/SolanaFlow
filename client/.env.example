# Copy to web/.env.local and adjust as needed

# Solana RPC endpoint
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# Identity & base path of this dApp (must match traefik labels in compose.yaml)
APP_ID=dev
APP_BASE_PATH=/dapp/${APP_ID}

# Disable Next telemetry
NEXT_TELEMETRY_DISABLED=1

# Backend URL the dApp may call
NEXT_PUBLIC_API_URL=http://localhost:9999

# Optional Alchemy key
NEXT_PUBLIC_ALCHEMY_KEY=

# Optional program ID displayed by components such as SolMintApp
NEXT_PUBLIC_PROGRAM_ID=
