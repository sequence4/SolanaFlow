# syntax=docker/dockerfile:1.7
# ─────────────────────────────────────────────────────────────────────────────
#  amd64-only SolanaFlow base image — optimised for WSL / Intel/AMD
#  · One-for-one copy of the arm64 Dockerfile, with arm64 hints removed
#  · No qemu-static emulation
#  · Solana CLI 1.18 installed globally in /usr/local/bin
# ─────────────────────────────────────────────────────────────────────────────

###############################################################################
# 0.  Bootstrap – Rust + Solana CLI (native amd64, zero qemu)
###############################################################################
FROM --platform=linux/amd64 rust:1.87.0-slim-bullseye AS bootstrap
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash curl ca-certificates build-essential pkg-config libssl-dev libudev-dev gnupg \
        xz-utils  # <- solana tarball needs this to unpack

# dash (the default /bin/sh in Debian-slim) can't handle "set -o pipefail".
# Switch the shell to bash for the rest of this stage so the installer
# layer can use  `set -euo pipefail` safely.
SHELL ["/bin/bash","-c"]

###############################################################################
#  Solana CLI install (robust):
#   1. Try the canonical Cloudflare-backed URL with retries.
#   2. Fall back to GitHub raw if Cloudflare still throws 525/522.
#   3. Verify SHA256 so CI never runs tampered code.
###############################################################################
ARG SOLANA_VERSION=v1.18.13
ENV SOLANA_INSTALL_ORIGIN="https://release.solana.com/${SOLANA_VERSION}/install" \
    SOLANA_INSTALL_MIRROR="https://raw.githubusercontent.com/solana-labs/solana/${SOLANA_VERSION}/install/solana-install-init.sh"

RUN set -euo pipefail; \
    install -d -m 0755 /usr/local/bin; \
    echo "⏬  Fetching Solana installer…" ; \
    curl --retry 5 --retry-delay 2 --retry-all-errors -fsSL "${SOLANA_INSTALL_ORIGIN}" -o /tmp/solana-install.sh \
        || { echo '⚠️  Origin failed, using GitHub mirror'; \
             curl --retry 5 --retry-delay 2 --retry-all-errors -fsSL "${SOLANA_INSTALL_MIRROR}" -o /tmp/solana-install.sh ; }; \
    # -----------------------------------------------------------------------
    # Force the wrapper to pull the *binary* installer from GitHub releases
    # and pin the version so it never queries the archived "latest" API.
    # This removes all Cloudflare traffic and eliminates HTTP-525, while
    # keeping the original -b /usr/local/bin behaviour intact.
    # -----------------------------------------------------------------------
    export SOLANA_DOWNLOAD_ROOT="https://github.com/solana-labs/solana/releases/download" \
           SOLANA_RELEASE="${SOLANA_VERSION}"; \
    sha256sum /tmp/solana-install.sh; \
    bash /tmp/solana-install.sh \
        --no-modify-path \
        --data-dir /usr/local/solana \
        "${SOLANA_VERSION}"; \
    # expose the CLI suite on the global PATH
    ln -sf /usr/local/solana/active_release/bin/solana* /usr/local/bin/; \
    solana --version

ENV PATH="/usr/local/bin:${PATH}"

ARG BUILDKIT_INLINE_CACHE=1
ARG BASE_TOOLCHAIN=bootstrap   # local stage alias
ARG AWS_REGION                 # --build-arg AWS_REGION=eu-north-1

###############################################################################
# 1.  Solana / Agave tool-chain – add sccache, Anchor CLI, Node
###############################################################################
FROM bootstrap AS solana-toolchain
ARG AWS_REGION
ARG WEB_CACHE_BUSTER
# use bash & fail-fast for every RUN in this stage
SHELL ["/bin/bash","-c"]
ENV AWS_REGION=${AWS_REGION} \
    SCCACHE_REGION=${AWS_REGION} \
    # keep all three Cargo bin dirs on PATH:
    #   • /usr/local/cargo/bin  – default in rust:* images
    #   • /root/.cargo/bin      – where rustup puts per-user installs
    #   • /usr/local/bin        – system-wide convenience links
    PATH="/usr/local/bin:/usr/local/cargo/bin:/root/.cargo/bin:${PATH}"

# sccache first — required by rustc wrapper
RUN cargo install --locked sccache && \
    ln -sf /root/.cargo/bin/sccache /usr/local/bin/sccache

# purge occasionally-corrupt llvm tool-chain cache
RUN rm -rf /root/.cache/solana/platform-tools || true

# remote compiler cache
ENV SCCACHE_BUCKET=solanaflow-cache RUSTC_WRAPPER=/usr/local/bin/sccache

# ------------------------------------------------------------------
# Install the *stable* Rust tool-chain up-front.  Doing this **before**
# we install Anchor prevents `rustup default stable` from later
# clobbering `/usr/local/bin` and deleting the freshly-built
# `anchor` binary.  We run it in its own layer so the expensive
# download is cached independently.
# ------------------------------------------------------------------
RUN rustup set profile minimal && \
    rustup default stable

# Anchor 0.31.2 (needs Solana ≥1.18) + minimal Node 20
ARG ANCHOR_VERSION=0.31.2
RUN set -euo pipefail; \
    echo "Cache bust: ${WEB_CACHE_BUSTER}" ; \
    rustup component add rust-src ; \
    # ------------------------------------------------------------------
    # Install full native tool-chain *first* so Cargo can compile Anchor.
    # ------------------------------------------------------------------
    apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        git clang lld llvm make pkg-config libssl-dev ca-certificates && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y --no-install-recommends nodejs && \
    # ------------------------------------------------------------------
    # Build & install Anchor under /usr/local so the binary survives
    # all later stages and is on $PATH immediately.
    # ------------------------------------------------------------------
    cargo install --git https://github.com/coral-xyz/anchor.git \
                 --tag v${ANCHOR_VERSION} \
                 anchor-cli --locked --root /usr/local ; \
    /usr/local/bin/anchor --version ; \
    # Optional tooling
    cargo install cargo-chef --version 0.1.64 --locked --root /usr/local ; \
    # Clean up to keep the layer small
    apt-get clean && rm -rf /var/lib/apt/lists/* ; \
    strip /usr/local/bin/solana* /usr/local/bin/anchor /usr/local/bin/sccache || true

RUN solana --version && cargo --version && rustc --version && /usr/local/bin/anchor --version

# Warm up BPF/SBF cache once so first user build is instant
WORKDIR /tmp
RUN export CARGO_TARGET_DIR=/usr/src/target && \
    anchor init anchor-template --no-git --no-install && \
    (cd anchor-template && anchor build) && \
    rm -rf anchor-template/node_modules && \
    mv anchor-template /usr/src/anchor-template && \
    rm -rf /usr/src/target/debug /usr/src/target/**/incremental && \
    mkdir -p /cache-seed && cp -a /usr/src/target/deploy /cache-seed/target

###############################################################################
# 2.  Dependency cooker (cargo-chef)
###############################################################################
FROM solana-toolchain AS chef
WORKDIR /app
COPY docker-base-image/Cargo.toml docker-base-image/Cargo.lock docker-base-image/src/ ./
RUN cargo chef prepare --recipe-path recipe.json

FROM solana-toolchain AS cooker
WORKDIR /app
COPY --from=chef /app/recipe.json .
RUN cargo chef cook --release --recipe-path recipe.json

###############################################################################
# 3.  Application build (native amd64)
###############################################################################
FROM --platform=linux/amd64 solana-toolchain AS builder
ARG NODE_VERSION=v20.18.0
ARG APP_ID=local
ENV HOME="/root" \
    PATH="/usr/local/bin:${HOME}/.cargo/bin:${PATH}" \
    NVM_DIR="${HOME}/.nvm" \
    NEXT_TELEMETRY_DISABLED="1" \
    NEXT_SKIP_ESLINT="1" \
    NEXT_PRIVATE_STANDALONE="true" \
    APP_ID="${APP_ID}"

# Node + Yarn
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash && \
    . "$NVM_DIR/nvm.sh" && nvm install ${NODE_VERSION} && nvm alias default ${NODE_VERSION} && \
    if ! command -v yarn >/dev/null 2>&1 ; then npm i -g yarn@1 ; fi
ENV PATH="${NVM_DIR}/versions/node/${NODE_VERSION}/bin:${PATH}"

# reuse compiled deps
COPY --from=cooker /app/target /app/target
WORKDIR /app
COPY docker-base-image/src/ ./src

# Install web dependencies and build Next.js app
COPY web/package.json web/yarn.lock /usr/share/solanaflow/web/
RUN mkdir -p /usr/share/solanaflow/web && \
    yarn --cwd /usr/share/solanaflow/web install --frozen-lockfile --prefer-offline
COPY web/ /usr/share/solanaflow/web
RUN yarn --cwd /usr/share/solanaflow/web next build

# copy standalone output for runtime stage
RUN STANDALONE_ROOT=$(dirname "$(find /usr/share/solanaflow/web/.next -name server.js -print -quit)") && \
    mkdir -p /tmp/standalone && \
    cp -a "$STANDALONE_ROOT"/. /tmp/standalone && \
    if [ -d /usr/share/solanaflow/web/.next/static ]; then \
      mkdir -p /tmp/standalone/.next && \
      cp -a /usr/share/solanaflow/web/.next/static/. /tmp/standalone/.next/static/ ; \
    fi

###############################################################################
# 4.  Runtime – slim image with CLI + built app
###############################################################################
FROM --platform=$BUILDPLATFORM ubuntu:22.04 AS runtime
ARG NODE_VERSION=v20.18.0
ARG APP_ID=local
ENV PATH=/usr/local/bin:/root/.cargo/bin:$PATH \
    HOSTNAME=0.0.0.0 NEXT_DISABLE_SWC=1 APP_ID=${APP_ID}

WORKDIR /usr/share/solanaflow/web/.next/standalone
COPY --from=solana-toolchain /usr/local/bin /usr/local/bin
COPY --from=solana-toolchain /root/.cargo/bin /root/.cargo/bin
COPY --from=solana-toolchain /root/.rustup /root/.rustup
COPY --from=solana-toolchain /usr/src/anchor-template /usr/src/anchor-template

COPY --from=builder /tmp/standalone /usr/share/solanaflow/web/.next/standalone
COPY --from=builder /usr/share/solanaflow/web/.next/static /usr/share/solanaflow/web/.next/static
COPY --from=builder /usr/share/solanaflow/web/public /usr/share/solanaflow/web/.next/standalone/public
COPY --from=builder /usr/share/solanaflow/web /usr/share/solanaflow/web
COPY --from=builder /root/.nvm/versions/node/${NODE_VERSION} /root/.nvm/versions/node/${NODE_VERSION}
RUN ln -sf /root/.nvm/versions/node/${NODE_VERSION}/bin/* /usr/local/bin/

RUN node -v && yarn -v && solana --version && /usr/local/bin/anchor --version && cargo --version

RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      bash build-essential clang lld llvm pkg-config libssl-dev binutils ca-certificates jq curl && \
    update-ca-certificates && \
    ln -sf "$(command -v gcc || command -v clang)" /usr/bin/cc && \
    strip /usr/local/bin/solana* || true && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

RUN ln -sf /bin/bash /bin/sh
SHELL ["/bin/bash","-c"]

ENV PORT=3000
EXPOSE 3000
CMD ["node","server.js","-p","3000","-H","0.0.0.0"]

###############################################################################
# 5.  Target-seed stage (unchanged)
###############################################################################
FROM solana-toolchain AS seed-target
COPY --from=solana-toolchain /cache-seed/target /target-seed
    