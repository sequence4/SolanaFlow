FROM --platform=linux/arm64 ubuntu:22.04 AS builder
ARG DEBIAN_FRONTEND=noninteractive
ARG NODE_VERSION="v20.18.0"
ARG SOLANA_CHANNEL="stable"

ENV HOME=/root
ENV PATH=$HOME/.cargo/bin:$HOME/.local/share/solana/install/active_release/bin:$HOME/.nvm/versions/node/${NODE_VERSION}/bin:$PATH

# ── base packages ──────────────────────────────────────────────────────────
RUN set -e; \
    echo 'Acquire::Retries "3";' > /etc/apt/apt.conf.d/80retry; \
    apt-get update -o Acquire::AllowReleaseInfoChange=true -qq && \
    apt-get install -y --no-install-recommends \
        build-essential git curl wget jq pkg-config python3 \
        libssl-dev libudev-dev zlib1g-dev llvm clang cmake make \
        libprotobuf-dev protobuf-compiler ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Rust
RUN curl -sSf https://sh.rustup.rs | bash -s -- -y --profile minimal --default-toolchain stable && \
    . "$HOME/.cargo/env" && rustup component add rustfmt clippy

# Node + Yarn
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
ENV NVM_DIR=$HOME/.nvm
RUN . "$NVM_DIR/nvm.sh" && nvm install ${NODE_VERSION} && nvm use ${NODE_VERSION} && \
    nvm alias default ${NODE_VERSION} && npm install -g yarn

# Solana CLI
RUN (curl -sSfL "https://release.anza.xyz/solana/${SOLANA_CHANNEL}/install" | bash -s -- -y) || \
    (curl -sSfL "https://release.solana.com/${SOLANA_CHANNEL}/install" | bash -s -- -y)

# Anchor CLI
RUN cargo install --git https://github.com/coral-xyz/anchor anchor-cli --tag v0.31.1 --locked --force && \
    anchor --version

# Anchor template (cache-warm)
RUN set -e; \
    mkdir -p /usr/src /opt && \
    cd /usr/src && anchor init anchor-template --no-git && \
    cd anchor-template && anchor build -- --locked || true && \
    rm -rf target && mv /usr/src/anchor-template /opt/anchor-template

ARG CACHEBUST=20250524
RUN echo "$CACHEBUST"

# Minimal Next.js scaffold (for web playground)
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_SKIP_ESLINT=1
RUN set -e; \
    mkdir -p /usr/share/solanaflow && \
    CI=1 yarn create next-app /usr/share/solanaflow/web \
      --typescript --eslint --tailwind --app --no-src-dir --no-interactive && \
    yarn --cwd /usr/share/solanaflow/web add -E @tailwindcss/postcss@latest && \
    printf '\nmodule.exports = { output: "standalone" };\n' >> /usr/share/solanaflow/web/next.config.js && \
    yarn --cwd /usr/share/solanaflow/web install --frozen-lockfile && \
    yarn --cwd /usr/share/solanaflow/web build && \
    yarn --cwd /usr/share/solanaflow/web install --production --ignore-scripts --prefer-offline && \
    rm -rf /usr/share/solanaflow/web/.next/cache && \
    # ---- CLEAN BUILD CACHES ----------------------------------------------
    yarn --cwd /usr/share/solanaflow/web cache clean --all && \
    rm -rf /usr/local/share/.cache/yarn  /root/.cache/yarn  "$NVM_DIR/.cache"

# Guarantee Solana bin dir exists (defensive)
RUN mkdir -p /root/.local/share/solana/install/active_release/bin

# Expose tools via universally-searched path
RUN ln -sf /root/.cargo/bin/anchor /usr/local/bin/anchor && \
    ln -sf /root/.local/share/solana/install/active_release/bin/solana* /usr/local/bin/ || true

# ── runtime stage ─────────────────────────────────────────────────────────
FROM builder AS runtime
ARG RUNTIME_BUST=20250527
RUN echo "$RUNTIME_BUST"

ENV HOSTNAME=0.0.0.0
ENV NEXT_DISABLE_SWC=1
WORKDIR /usr/share/solanaflow/web

# app + template
COPY --from=builder /usr/share/solanaflow   /usr/share/solanaflow
COPY --from=builder /opt/anchor-template    /usr/src/anchor-template

# Solana + Anchor tool-chain
COPY --from=builder /root/.local/share/solana /root/.local/share/solana
COPY --from=builder /root/.cargo/bin          /root/.cargo/bin
COPY --from=builder /usr/local/bin/anchor     /usr/local/bin/anchor

# 🔑 expose Solana CLI (and any helpers) universally
# 1) explicit "solana" + "solana-keygen" – these are what Anchor/Scripts call
RUN ln -sf /root/.local/share/solana/install/active_release/bin/solana        /usr/local/bin/solana  && \
    ln -sf /root/.local/share/solana/install/active_release/bin/solana-keygen /usr/local/bin/solana-keygen && \
    # 2) catch-all for any other helper binaries (validator, install, etc.)
    ln -sf /root/.local/share/solana/install/active_release/bin/solana*       /usr/local/bin/ || true

# Put the Solana bin dir into PATH *before* we smoke-test
ENV PATH=/root/.local/share/solana/install/active_release/bin:/root/.cargo/bin:/usr/local/bin:$PATH

# Smoke-test: abort build early if any tool disappeared
RUN solana --version && anchor --version && rustc --version

EXPOSE 3000
CMD ["node", ".next/standalone/server.js"]