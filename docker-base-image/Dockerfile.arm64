    FROM --platform=linux/arm64 ubuntu:22.04 AS builder

    ARG  DEBIAN_FRONTEND=noninteractive
    ARG  NODE_VERSION="v20.16.0"
    
    ENV  HOME="/root" \
         PATH="$HOME/.cargo/bin:$HOME/.local/share/solana/install/active_release/bin:$HOME/.nvm/versions/node/${NODE_VERSION}/bin:$PATH"
    
    RUN apt-get update -qq && \
        apt-get install -y --no-install-recommends \
            build-essential git curl wget jq pkg-config python3 \
            libssl-dev libudev-dev zlib1g-dev llvm clang cmake make \
            protobuf-compiler ca-certificates && \
        apt-get clean && rm -rf /var/lib/apt/lists/*
    
    RUN curl -sSf https://sh.rustup.rs | bash -s -- -y --profile minimal --default-toolchain stable && \
        rustup component add rustfmt clippy
    
    RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
    ENV  NVM_DIR=$HOME/.nvm
    RUN . $NVM_DIR/nvm.sh && \
        nvm install ${NODE_VERSION} && \
        nvm use ${NODE_VERSION} && \
        nvm alias default ${NODE_VERSION} && \
        npm install -g yarn
    
    RUN bash -c "$(curl -sSfL https://release.anza.xyz/stable/install)"
    
    RUN cargo install --git https://github.com/coral-xyz/anchor avm --locked --force && \
        avm install latest && \
        anchor --version
    
    RUN mkdir -p /tmp/bootstrap && cd /tmp/bootstrap && \
        anchor init dummy --no-git && \
        cd dummy && anchor build -- --locked && \
        rm -rf target                               # only need cache in ~/.cache
    
    RUN mkdir -p /usr/share/flowcode && \
        npx --yes create-next-app@latest /usr/share/flowcode/template-nextjs \
            --typescript --eslint --tailwind --no-src-dir --app --use-yarn && \
        yarn --cwd /usr/share/flowcode/template-nextjs install --production
    
    RUN solana-keygen new --no-passphrase -o /root/.config/solana/id.json && \
        solana config set --url http://127.0.0.1:8899 && \
        (solana airdrop 2 || true)                 # ignore if no local validator
    
    FROM builder AS runtime
    
    WORKDIR /workspace                              # persistent project volume :contentReference[oaicite:1]{index=1}
    VOLUME  /workspace
    
    COPY --from=builder /usr/share/flowcode /usr/share/flowcode
    
    CMD ["sleep","infinity"]
    