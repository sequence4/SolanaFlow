# syntax=docker/dockerfile:1.7
ARG BUILDKIT_INLINE_CACHE=1
ARG BASE_TOOLCHAIN=ghcr.io/sequence4/solana-toolchain:latest
# Build-time AWS region (passed from `docker buildx ... --build-arg AWS_REGION=eu-north-1`)
ARG AWS_REGION

###############################################################################
# 1.  Solana / Agave tool-chain – pulled pre-built, then lightly patched
###############################################################################
FROM ${BASE_TOOLCHAIN} AS solana-toolchain
# Re-declare build arg inside this stage, then expose as env so the AWS SDK in
# `sccache` knows what endpoint to talk to.
ARG AWS_REGION
ENV AWS_REGION=${AWS_REGION} \
    SCCACHE_REGION=${AWS_REGION}
LABEL stage=toolchain

# hot-fix so cargo-install-all.sh can find the CLI artefact
RUN [ -d /solana-src ] && ln -sf /opt/target /solana-src/target || true

# remote compiler cache (S3, GCS …)
ENV SCCACHE_BUCKET=solanaflow-cache \
    RUSTC_WRAPPER=/usr/local/bin/sccache

# add Anchor CLI + minimal Node once (not in the base image yet)
RUN --mount=type=secret,id=aws,target=/root/.aws/credentials \
    --mount=type=cache,id=sccache,target=/opt/sccache,sharing=locked \
    --mount=type=cache,id=apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lib,target=/var/lib/apt,sharing=locked \
    rustup component add rust-src \
 && cargo install anchor-cli  --version 0.31.1   --locked \
 && cargo install cargo-chef --version 0.1.64    --locked \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && strip /usr/local/bin/solana*

RUN rustup set profile minimal && rustup default stable


# warm the BPF / SBF cache once so first user build is instant
WORKDIR /tmp
RUN --mount=type=secret,id=aws,target=/root/.aws/credentials \
    --mount=type=cache,id=sccache,target=/opt/sccache,sharing=locked \
    export CARGO_TARGET_DIR=/usr/src/target && \
    anchor init anchor-template --no-git --no-install \
 && (cd anchor-template && anchor build) \
 && rm -rf anchor-template/node_modules \
 && rm -rf /usr/src/anchor-template \
 && mv anchor-template /usr/src/anchor-template \
 && rm -rf /tmp/* \
 && mkdir -p /cache-seed \
 && cp -a /usr/src/target /cache-seed/target

# quick smoke-test
RUN solana --version && cargo --version && rustc --version && anchor --version

###############################################################################
# 2.  Dependency cooker (cargo-chef)
###############################################################################
FROM solana-toolchain AS chef
WORKDIR /app
COPY Cargo.toml Cargo.lock src/ ./
RUN cargo chef prepare --recipe-path recipe.json

FROM solana-toolchain AS cooker
WORKDIR /app
COPY --from=chef /app/recipe.json .
RUN --mount=type=secret,id=aws,target=/root/.aws/credentials \
    --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=sccache,target=/opt/sccache,sharing=locked \
    cargo chef cook --release --recipe-path recipe.json

###############################################################################
# 3.  Application build (arm64 ⇒ Graviton-friendly)
###############################################################################
FROM --platform=linux/arm64 solana-toolchain AS builder
ARG NODE_VERSION=v20.18.0
ENV HOME=/root
ENV PATH=/usr/local/bin:$HOME/.cargo/bin:$PATH
ENV NVM_DIR=$HOME/.nvm
ENV PATH="$NVM_DIR/versions/node/${NODE_VERSION}/bin:$PATH"

# reuse compiled dependencies
COPY --from=cooker /app/target /app/target

# project source
WORKDIR /app
COPY src/ ./src

# Node + Yarn (cached)
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
RUN . "$NVM_DIR/nvm.sh" \
 && nvm install ${NODE_VERSION} \
 && nvm alias default ${NODE_VERSION} \
 && npm i -g yarn

ENV NEXT_TELEMETRY_DISABLED=1 NEXT_SKIP_ESLINT=1
# --- Force Next 14 + to emit the standalone bundle ---------------------------
ENV NEXT_PRIVATE_STANDALONE=true
RUN --mount=type=cache,id=yarn-cache,target=/usr/local/share/.cache/yarn,sharing=locked \
    mkdir -p /usr/share/solanaflow \
 && CI=1 yarn create next-app /usr/share/solanaflow/web \
        --typescript --eslint --tailwind --app --no-src-dir --no-interactive \
 && printf '\nmodule.exports = { output: "standalone" };\n' >> /usr/share/solanaflow/web/next.config.js \
 && yarn --cwd /usr/share/solanaflow/web install --frozen-lockfile \
 && yarn --cwd /usr/share/solanaflow/web build \
 && yarn cache clean --all || true

# fail the build early if the expected file is missing
RUN test -f /usr/share/solanaflow/web/.next/standalone/server.js

###############################################################################
# 4.  Runtime – slim image with CLI + built app
###############################################################################
FROM ubuntu:22.04 AS runtime
ENV PATH=/usr/local/bin:/root/.cargo/bin:$PATH \
    HOST=0.0.0.0 \
    NEXT_DISABLE_SWC=1
WORKDIR /usr/share/solanaflow/web

# bring in binaries and web bundle
COPY --from=solana-toolchain /usr/local/bin /usr/local/bin
COPY --from=solana-toolchain /root/.cargo/bin /root/.cargo/bin
COPY --from=solana-toolchain /root/.rustup /root/.rustup
COPY --from=builder /usr/share/solanaflow /usr/share/solanaflow
COPY --from=solana-toolchain /usr/src/anchor-template /usr/src/anchor-template
# bring in the exact Node we used to build the standalone bundle
COPY --from=builder /root/.nvm/versions/node/v20.18.0/bin/node /usr/local/bin/node

RUN solana --version && anchor --version
RUN cargo --version  && rustc --version
# --- base tool-chain and libraries needed for Anchor / Rust programs ----------
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        build-essential \
        clang \
        lld \
        llvm \
        pkg-config \
        libssl-dev \
        binutils \
        ca-certificates \
        jq && \
    update-ca-certificates && \
    # make sure /usr/bin/cc exists
    ln -sf "$(command -v gcc || command -v clang)" /usr/bin/cc && \
    strip /usr/local/bin/solana* || true && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

EXPOSE 3000
# Next 15+ puts the entry-point at  .next/standalone/server.js
# https://vercel.com/guides/nextjs-advanced-features#standalone-build-output
CMD ["node", "/usr/share/solanaflow/web/.next/standalone/server.js"]

# create a separate stage for seeding the target volume
FROM solana-toolchain AS seed-target
COPY --from=solana-toolchain /cache-seed/target /target-seed
