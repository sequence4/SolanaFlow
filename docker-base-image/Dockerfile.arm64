# syntax=docker/dockerfile:1.7
ARG BUILDKIT_INLINE_CACHE=1
ARG BASE_TOOLCHAIN=ghcr.io/sequence4/solana-toolchain:latest
# Build-time AWS region (passed from `docker buildx ... --build-arg AWS_REGION=eu-north-1`)
ARG AWS_REGION

###############################################################################
# 1.  Solana / Agave tool-chain – pulled pre-built, then lightly patched
###############################################################################
FROM ${BASE_TOOLCHAIN} AS solana-toolchain
# Re-declare build arg inside this stage, then expose as env so the AWS SDK in
# `sccache` knows what endpoint to talk to.
ARG AWS_REGION
ENV AWS_REGION=${AWS_REGION} \
    SCCACHE_REGION=${AWS_REGION}
LABEL stage=toolchain

# ────────────────────────────────────────────────────────────────
# Work-around for sporadic "Failed to unpack llvm/bin/lld" when the
# Solana platform-tools cache gets corrupted. Purge it before we
# pre-warm the BPF/SBF tool-chain so every fresh build starts clean.
RUN rm -rf /root/.cache/solana/platform-tools || true
# ────────────────────────────────────────────────────────────────

# hot-fix so cargo-install-all.sh can find the CLI artefact
RUN [ -d /solana-src ] && ln -sf /opt/target /solana-src/target || true

# remote compiler cache (S3, GCS …)
ENV SCCACHE_BUCKET=solanaflow-cache \
    RUSTC_WRAPPER=/usr/local/bin/sccache

# add Anchor CLI + minimal Node once (not in the base image yet)
RUN --mount=type=secret,id=aws,target=/root/.aws/credentials \
    --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=sccache,target=/opt/sccache,sharing=locked \
    --mount=type=cache,id=apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lib,target=/var/lib/apt,sharing=locked \
    rustup component add rust-src \
 && cargo install anchor-cli  --version 0.31.1   --locked \
 && cargo install cargo-chef --version 0.1.64    --locked \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs curl \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && strip /usr/local/bin/solana*

RUN rustup set profile minimal && rustup default stable


# warm the BPF / SBF cache once so first user build is instant
WORKDIR /tmp
RUN --mount=type=secret,id=aws,target=/root/.aws/credentials \
    --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=sccache,target=/opt/sccache,sharing=locked \
    export CARGO_TARGET_DIR=/usr/src/target && \
    anchor init anchor-template --no-git --no-install \
 && (cd anchor-template && anchor build) \
 && rm -rf anchor-template/node_modules \
 && rm -rf /usr/src/anchor-template \
 && mv anchor-template /usr/src/anchor-template \
 && rm -rf /tmp/* \
# drop huge host-side artefacts — we only need the BPF release output
&& rm -rf /usr/src/target/debug /usr/src/target/**/incremental \
&& mkdir -p /cache-seed \
&& cp -a /usr/src/target/deploy /cache-seed/target

# quick smoke-test
RUN solana --version && cargo --version && rustc --version && anchor --version

###############################################################################
# 2.  Dependency cooker (cargo-chef)
###############################################################################
FROM solana-toolchain AS chef
WORKDIR /app
COPY docker-base-image/Cargo.toml docker-base-image/Cargo.lock docker-base-image/src/ ./
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=sccache,target=/opt/sccache,sharing=locked \
    cargo chef prepare --recipe-path recipe.json

FROM solana-toolchain AS cooker
WORKDIR /app
COPY --from=chef /app/recipe.json .
RUN --mount=type=secret,id=aws,target=/root/.aws/credentials \
    --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=sccache,target=/opt/sccache,sharing=locked \
    cargo chef cook --release --recipe-path recipe.json

###############################################################################
# 3.  Application build (arm64 ⇒ Graviton-friendly)
###############################################################################
FROM --platform=linux/arm64 solana-toolchain AS builder
ARG NODE_VERSION=v20.18.0
ENV HOME=/root
ENV PATH=/usr/local/bin:$HOME/.cargo/bin:$PATH
ENV NVM_DIR=$HOME/.nvm
ENV PATH="$NVM_DIR/versions/node/${NODE_VERSION}/bin:$PATH"

# reuse compiled dependencies
COPY --from=cooker /app/target /app/target

# project source
WORKDIR /app
COPY docker-base-image/src/ ./src

# Node + Yarn (cached)
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
RUN . "$NVM_DIR/nvm.sh" \
 && nvm install ${NODE_VERSION} \
 && nvm alias default ${NODE_VERSION} \
 && if ! command -v yarn >/dev/null 2>&1 ; then npm i -g yarn@1 ; fi

ENV NEXT_TELEMETRY_DISABLED=1 NEXT_SKIP_ESLINT=1 NEXT_PRIVATE_STANDALONE=true
# copy the web/ directory that already exists in the repo
COPY web/ /usr/share/solanaflow/web
# bump this from the CLI to bust the build cache whenever web/ changes
ARG NEXT_BUILD_CACHE_BUSTER
RUN mkdir -p /usr/share/solanaflow/web/public

# install deps and build once
RUN --mount=type=cache,id=yarn-cache,target=/usr/local/share/.cache/yarn,sharing=locked \
    yarn --cwd /usr/share/solanaflow/web install --frozen-lockfile \
 && yarn --cwd /usr/share/solanaflow/web \
        next build \
 && yarn cache clean --all || true

# Debug: show where Next placed the standalone output
RUN echo 'Preview of .next layout:' && \
    find /usr/share/solanaflow/web/.next -maxdepth 3 -type f | head -n 30

# Locate server.js anywhere under .next, then copy its parent dir
RUN STANDALONE_ROOT=$(dirname "$(find /usr/share/solanaflow/web/.next -name server.js -print -quit)") && \
    test -n "$STANDALONE_ROOT" && echo "✔ Found standalone directory at $STANDALONE_ROOT" || \
        (echo '❌  server.js (standalone) not found. Is output: \"standalone\" set?' && exit 1) && \
    mkdir -p /tmp/standalone && \
    cp -a "$STANDALONE_ROOT"/. /tmp/standalone

# create a separate stage for seeding the target volume
FROM solana-toolchain AS seed-target
COPY --from=solana-toolchain /cache-seed/target /target-seed

###############################################################################
# 4.  Runtime – slim image with CLI + built app
###############################################################################
# ────────────────────────────────────────────────────────────────
# runtime stage  ➜  copy the *full* Yarn 1.x install from builder
#   · yarn in /usr/local/bin is just a shim that calls ../lib/cli
#   · therefore we MUST also copy /usr/local/lib/node_modules/yarn
# ────────────────────────────────────────────────────────────────
FROM --platform=$BUILDPLATFORM ubuntu:22.04 AS runtime
ENV PATH=/usr/local/bin:/root/.cargo/bin:$PATH \
    HOSTNAME=0.0.0.0 \
    NEXT_DISABLE_SWC=1
WORKDIR /usr/share/solanaflow/web

# bring in binaries and web bundle
COPY --from=solana-toolchain /usr/local/bin /usr/local/bin
COPY --from=solana-toolchain /root/.cargo/bin /root/.cargo/bin
COPY --from=solana-toolchain /root/.rustup /root/.rustup
# ── web bundle ────────────────────────────────────────────────────────────────
# Next 'standalone' output lives in:
#   web/.next/standalone/…   (server code + _next/static)
#   web/public/…             (static public assets)

# ① server bundle — copy the complete standalone folder (already includes _next/static)
COPY --from=builder /tmp/standalone \
                    /usr/share/solanaflow/web/.next/standalone

# ② public assets (favicon, OG images…)
COPY --from=builder /usr/share/solanaflow/web/public \
                    /usr/share/solanaflow/web/.next/standalone/public

# also copy the project itself (src/, app/, idl/, …)
COPY --from=builder /usr/share/solanaflow/web                  /usr/share/solanaflow/web
COPY --from=solana-toolchain /usr/src/anchor-template /usr/src/anchor-template

# copy the entire Node version dir (≈ 28 MB) – includes node, npm, corepack, etc.
COPY --from=builder /root/.nvm/versions/node/v20.18.0 /root/.nvm/versions/node/v20.18.0
RUN ln -sf /root/.nvm/versions/node/v20.18.0/bin/* /usr/local/bin/

# sanity-check Yarn & Node
RUN node -v && yarn -v      # should print 20.18.0 / 1.22.x

# --------------------------------------------------------------------------------
# everything below this line is unchanged

RUN solana --version && anchor --version
RUN cargo --version  && rustc --version
# --- base tool-chain and libraries needed for Anchor / Rust programs ----------
RUN apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        # guarantee /bin/bash so Node's child_process.spawn never ENOENTs
        bash \
        build-essential \
        clang \
        lld \
        llvm \
        pkg-config \
        libssl-dev \
        binutils \
        ca-certificates \
        jq \
        curl && \
    update-ca-certificates && \
    # make sure /usr/bin/cc exists
    ln -sf "$(command -v gcc || command -v clang)" /usr/bin/cc && \
    strip /usr/local/bin/solana* || true && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# optional one-liner: make generic shells resolve too
RUN ln -sf /bin/bash /bin/sh

# from this point every RUN uses Bash automatically
SHELL ["/bin/bash","-c"]

EXPOSE 3000
# Entrypoint – run from the web root so that "_next/static" & "public" resolve
WORKDIR /usr/share/solanaflow/web
# NB: we exec the exact server.js we copied above
CMD ["bash","-c","node $(find /usr/share/solanaflow/web/.next/standalone -name server.js)"]
