# syntax=docker/dockerfile:1.7
ARG BUILDKIT_INLINE_CACHE=1
ARG BASE_TOOLCHAIN=ghcr.io/sequence4/solana-toolchain:v2.2.14

###############################################################################
# 1.  Solana / Agave tool-chain – pulled pre-built, then lightly patched
###############################################################################
FROM ${BASE_TOOLCHAIN} AS solana-toolchain
LABEL stage=toolchain

# hot-fix so cargo-install-all.sh can find the CLI artefact
RUN [ -d /solana-src ] && ln -sf /opt/target /solana-src/target || true

# remote compiler cache (S3, GCS …)
ENV SCCACHE_BUCKET=solanaflow-cache \
    RUSTC_WRAPPER=/usr/local/bin/sccache

# add Anchor CLI + minimal Node once (not in the base image yet)
RUN --mount=type=cache,id=apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lib,target=/var/lib/apt,sharing=locked \
    rustup component add rust-src \
 && cargo install anchor-cli --version 0.31.1 --locked \
 && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
 && apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs \
 && apt-get clean && rm -rf /var/lib/apt/lists/* \
 && strip /usr/local/bin/solana*

# warm the BPF / SBF cache once so first user build is instant
WORKDIR /tmp
RUN anchor init anchor-template --no-git --no-install \
 && (cd anchor-template && anchor build -- --locked) \
 && rm -rf anchor-template/node_modules \
 && mv anchor-template /usr/src/anchor-template \
 && rm -rf /tmp/*

# quick smoke-test
RUN solana --version && cargo build-sbf --version && anchor --version

###############################################################################
# 2.  Dependency cooker (cargo-chef)
###############################################################################
FROM solana-toolchain AS chef
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
RUN cargo chef prepare --recipe-path recipe.json

FROM solana-toolchain AS cooker
WORKDIR /app
COPY --from=chef /app/recipe.json .
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry,sharing=locked \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git,sharing=locked \
    --mount=type=cache,id=sccache,target=/opt/sccache,sharing=locked \
    cargo chef cook --release --recipe-path recipe.json

###############################################################################
# 3.  Application build (arm64 ⇒ Graviton-friendly)
###############################################################################
FROM --platform=linux/arm64 solana-toolchain AS builder
ARG NODE_VERSION=v20.18.0
ENV HOME=/root
ENV PATH=/usr/local/bin:$HOME/.cargo/bin:$PATH
ENV NVM_DIR=$HOME/.nvm
ENV PATH="$NVM_DIR/versions/node/${NODE_VERSION}/bin:$PATH"

# reuse compiled dependencies
COPY --from=cooker /app/target /app/target

# project source
WORKDIR /app
COPY src/ ./src

# Node + Yarn (cached)
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
RUN . "$NVM_DIR/nvm.sh" \
 && nvm install ${NODE_VERSION} \
 && nvm alias default ${NODE_VERSION} \
 && npm i -g yarn

ENV NEXT_TELEMETRY_DISABLED=1 NEXT_SKIP_ESLINT=1
RUN --mount=type=cache,id=yarn-cache,target=/usr/local/share/.cache/yarn,sharing=locked \
    mkdir -p /usr/share/solanaflow \
 && CI=1 yarn create next-app /usr/share/solanaflow/web \
        --typescript --eslint --tailwind --app --no-src-dir --no-interactive \
 && printf '\nmodule.exports = { output: "standalone" };\n' >> /usr/share/solanaflow/web/next.config.js \
 && yarn --cwd /usr/share/solanaflow/web install --frozen-lockfile \
 && yarn --cwd /usr/share/solanaflow/web build \
 && yarn cache clean && rm -rf /usr/local/share/.cache/yarn

###############################################################################
# 4.  Runtime – slim image with CLI + built app
###############################################################################
FROM ubuntu:22.04 AS runtime
ENV PATH=/usr/local/bin:/root/.cargo/bin:$PATH \
    HOST=0.0.0.0 \
    NEXT_DISABLE_SWC=1
WORKDIR /usr/share/solanaflow/web

# bring in binaries and web bundle
COPY --from=solana-toolchain /usr/local/bin /usr/local/bin
COPY --from=solana-toolchain /root/.cargo/bin /root/.cargo/bin
COPY --from=builder /usr/share/solanaflow /usr/share/solanaflow

RUN solana --version && anchor --version
RUN apt-get clean && rm -rf /var/lib/apt/lists/* && strip /usr/local/bin/solana*

EXPOSE 3000
CMD ["node", ".next/standalone/server.js"]
