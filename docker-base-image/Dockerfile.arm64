# syntax=docker/dockerfile:1.7
ARG BUILDKIT_INLINE_CACHE=1

################################################################################
# 1.  Compile Solana/Agave + SBF once, cache forever
################################################################################
FROM --platform=linux/arm64 ubuntu:22.04 AS solana-toolchain
LABEL stage=toolchain
ARG SOLANA_VERSION=v2.2.14
ARG SOLANA_REPO=https://github.com/anza-xyz/agave.git

# --- base packages (APT caches) ------------------------------------------------
RUN --mount=type=cache,id=apt-cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,id=apt-lib,target=/var/lib/apt,sharing=locked \
    apt-get update -qq && \
    DEBIAN_FRONTEND=noninteractive \
    apt-get install -y --no-install-recommends \
      build-essential git curl pkg-config llvm clang cmake protobuf-compiler \
      libssl-dev libudev-dev zlib1g-dev xz-utils bzip2 ca-certificates && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Rust + sccache ------------------------------------------------------------
RUN curl -sSf https://sh.rustup.rs | bash -s -- -y --profile minimal
# 1️⃣ add Cargo to PATH for every later layer
ENV PATH="/root/.cargo/bin:/usr/local/bin:${PATH}"

# 2️⃣ install sccache (wrapper not active yet)
RUN cargo install sccache --locked

# 3️⃣ expose sccache globally and turn it on
RUN ln -s /root/.cargo/bin/sccache /usr/local/bin/sccache
ENV RUSTC_WRAPPER=/usr/local/bin/sccache \
    SCCACHE_DIR=/opt/sccache

# --- clone Agave once (separate layer so Git is cached) ------------------------
RUN git clone --depth 1 --branch ${SOLANA_VERSION} ${SOLANA_REPO} /solana-src
WORKDIR /solana-src

# --- build all CLI + SBF helpers (cached Cargo & sccache) ----------------------
RUN --mount=type=cache,id=cargo-registry,target=/root/.cargo/registry \
    --mount=type=cache,id=cargo-git,target=/root/.cargo/git \
    --mount=type=cache,id=sccache,target=/opt/sccache \
    ./scripts/cargo-install-all.sh . || true

# --- copy CLI executables & SDK -------------------------------------------------
RUN find /solana-src/bin -maxdepth 1 -type f -exec install -m 0755 -t /usr/local/bin {} + \
    && cp -r /solana-src/platform-tools-sdk /usr/local/bin/platform-tools-sdk

# --- add cargo source & global target dir --------------------------------------
ENV RUSTUP_HOME=/root/.rustup \
    CARGO_HOME=/root/.cargo \
    CARGO_TARGET_DIR=/opt/target
RUN mkdir -p $CARGO_TARGET_DIR \
    && chown -R 1000:1000 $CARGO_TARGET_DIR   # node user later

# --- install Anchor & Node (minimal) -------------------------------------------
RUN rustup component add rust-src \
    && cargo install anchor-cli --version 0.31.1 --locked \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get update -qq \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends nodejs

# --- PRIME THE CACHE! ----------------------------------------------------------
# 1. create template     2. build it once     3. move into /usr/src
WORKDIR /tmp
RUN anchor init anchor-template --no-git --no-install \
    && (cd anchor-template && anchor build -- --locked) \
    && rm -rf anchor-template/node_modules \
    && mv anchor-template /usr/src/anchor-template

# --- clean up source tree ------------------------------------------------------
RUN rm -rf /solana-src /tmp/*

# --- sanity smoke tests --------------------------------------------------------
RUN solana --version && cargo build-sbf --version && anchor --version

################################################################################
# 2.  Builder stage – inherits tool-chain, builds app
################################################################################
FROM --platform=linux/arm64 solana-toolchain AS builder
ARG NODE_VERSION="v20.18.0"
ENV HOME=/root
ENV PATH=/usr/local/bin:$HOME/.cargo/bin:$PATH
ENV NVM_DIR=$HOME/.nvm
# 👇 make node & yarn visible in every later layer
ENV PATH="$NVM_DIR/versions/node/${NODE_VERSION}/bin:$PATH"

# --- Node + Yarn ---------------------------------------------------------------
RUN curl -fsSL https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
RUN . "$NVM_DIR/nvm.sh" && nvm install ${NODE_VERSION} && nvm alias default ${NODE_VERSION} && npm i -g yarn

# minimal Next.js scaffold (cached Yarn)
ENV NEXT_TELEMETRY_DISABLED=1 NEXT_SKIP_ESLINT=1
RUN --mount=type=cache,id=yarn-cache,target=/usr/local/share/.cache/yarn,sharing=locked \
    mkdir -p /usr/share/solanaflow && \
    CI=1 yarn create next-app /usr/share/solanaflow/web \
      --typescript --eslint --tailwind --app --no-src-dir --no-interactive && \
    printf '\nmodule.exports = { output: "standalone" };\n' >> /usr/share/solanaflow/web/next.config.js && \
    yarn --cwd /usr/share/solanaflow/web install --frozen-lockfile && \
    yarn --cwd /usr/share/solanaflow/web build && \
    yarn cache clean && rm -rf /usr/local/share/.cache/yarn

################################################################################
# 3.  Runtime – slim final image
################################################################################
FROM ubuntu:22.04 AS runtime
ENV PATH=/usr/local/bin:/root/.cargo/bin:$PATH \
    HOST=0.0.0.0 NEXT_DISABLE_SWC=1
WORKDIR /usr/share/solanaflow/web

# bring in compiled CLI + app
COPY --from=solana-toolchain /usr/local/bin /usr/local/bin
COPY --from=solana-toolchain /root/.cargo/bin /root/.cargo/bin
COPY --from=builder /usr/share/solanaflow /usr/share/solanaflow

RUN solana --version && anchor --version   # final smoke-test

EXPOSE 3000
CMD ["node", ".next/standalone/server.js"]