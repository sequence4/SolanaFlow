{
    "compilerOptions": {
      "target": "ES2022",
      "module": "commonjs",
      "lib": ["ES2022"],
      "allowJs": true,
      "outDir": "dist",
      "rootDir": "src",
      "strict": true,
      "noImplicitAny": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "moduleResolution": "node",
      "baseUrl": ".",
      "paths": {
        "*": ["node_modules/*"],
        "src/*": ["src/*"],
        "@/*": ["src/*"]
      },
      "typeRoots": ["./node_modules/@types", "./@types"],
      "skipLibCheck": false
    },
    "include": ["src/**/*", "@types/**/*.d.ts"],
    "exclude": [
      "node_modules",
      "src/**/*.spec.ts",
      "src/**/*.test.ts"
    ]
  }
  