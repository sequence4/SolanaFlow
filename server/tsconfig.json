{
  "compilerOptions": {
    /* ---------- language / emit ---------- */
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "allowJs": true,

    /* ---------- folders ---------- */
    /* rootDir removed so both src/ and tests/ are valid */
    "outDir": "dist",

    /* ---------- type-checking ---------- */
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true,

    /* ---------- module resolution ---------- */
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@db": ["tests/__mocks__/@db.ts"],
      "src/*": ["src/*"],
      "@/*": ["src/*"],
      "*": ["node_modules/*"]
    },

    /* ---------- ambient types ---------- */
    /* --- ensure Node's ambient types are available --- */
    "types": ["node"]
  },

  "include": [
    "src/**/*",
    "tests/**/*",
    "@types/**/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
