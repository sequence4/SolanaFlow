{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "lib": ["ES2022"],
      "allowJs": true,
      "outDir": "./dist",
      "rootDir": "src",
      "strict": true,
      "noImplicitAny": true,
      "esModuleInterop": true,
      "resolveJsonModule": true,
      "moduleResolution": "node",
      "baseUrl": "src",
      "paths": {
        "*": ["../node_modules/*"],
        "src/*": ["*"],
        "@/*": ["*"],
        "@db": ["../tests/__mocks__/@db.ts"]
      },
      "typeRoots": ["./node_modules/@types", "./tests/types"],
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true
    },
    "include": ["src/**/*", "@types/**/*.d.ts"],
    "exclude": [
      "node_modules",
      "src/**/*.spec.ts",
      "src/**/*.test.ts",
      "dist"
    ]
  }
  