{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "skipLibCheck": true,
    
    /* --- ensure Node's ambient types are available --- */
    "types": ["node"],
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "exclude": [
    "**/*.test.ts",
    "**/__tests__/**",
    "tests",
    "tests/**/*"
  ]
} 