{
    "name": "server",
    "version": "1.0.0",
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "start": "node -r module-alias/register dist/app.js",
        "dev": "ts-node -r tsconfig-paths/register src/app.ts",
        "lint": "eslint . --ext .ts",
        "test": "jest --passWithNoTests",
        "test:watch": "jest --watchAll   --config jest.config.js",
        "test:cov": "jest --coverage   --config jest.config.js",
        "seed:warm": "node -r dotenv-flow/config -r ts-node/register/transpile-only -r tsconfig-paths/register scripts/seedWarmDonor.ts"
    },
    "_moduleAliases": {
        "@": "dist"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "description": "",
    "dependencies": {
        "@coral-xyz/anchor": "^0.30.1",
        "@iarna/toml": "^2.2.5",
        "@irys/sdk": "^0.2.11",
        "@solana/web3.js": "^1.98.0",
        "@aws-sdk/client-secrets-manager": "^3.489.0",
        "@types/concat-stream": "^2.0.3",
        "arbundles": "^0.11.2",
        "bcryptjs": "^3.0.2",

        "concat-stream": "^2.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dockerode": "^3.3.0",
        "dotenv": "^16.4.7",
        "dotenv-flow": "^4.1.0",
        "express": "^4.21.2",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "openai": "^4.85.4",
        "pg": "^8.13.3",
        "slugify": "^1.6.6",
        "tar-stream": "^3",
        "ts-node": "^10.9.2",
        "tweetnacl": "^1.0.3",
        "undici": "^5.29.0",
        "uuid": "^11.1.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@eslint/js": "^9.24.0",
        "@types/cookie-parser": "^1.4.8",
        "@types/cors": "^2.8.17",
        "@types/dockerode": "^3.3.40",
        "@types/express": "^5.0.0",
        "@types/jest": "^29.5.14",
        "@types/jsonwebtoken": "^9.0.9",
        "@types/node": "^20.19.0",
        "@types/pg": "^8.11.11",
        "@types/tar-stream": "^3",
        "@typescript-eslint/eslint-plugin": "^8.29.0",
        "@typescript-eslint/parser": "^8.29.0",
        "eslint": "^9",
        "globals": "^16.0.0",
        "jest": "^29.7.0",
        "ts-jest": "^29.1.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3"
    }
