# **Server Environment Variables**

# REQUIRED:
PORT=9999                        # Port for the Express server (default 9999 if not set):contentReference[oaicite:2]{index=2}
JWT_SECRET=your_jwt_secret_here  # Secret key for JWT signing/verification:contentReference[oaicite:3]{index=3}
ROOT_FOLDER=/absolute/path/to/projects  # Root directory for project files:contentReference[oaicite:4]{index=4}
WALLETS_FOLDER=/absolute/path/to/wallets # Directory to store Solana wallet keypairs:contentReference[oaicite:5]{index=5}
DATABASE_URL=postgres://user:password@host:5432/database_name  # PostgreSQL connection string:contentReference[oaicite:6]{index=6}

# API Keys / Secrets:
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx  # OpenAI API key for AI features:contentReference[oaicite:7]{index=7}
BETA_CODE=YOUR_BETA_CODE            # Comma-separated beta invite codes (if gating sign-ups):contentReference[oaicite:8]{index=8}

# Optional Settings (with defaults shown):
CLEANUP_POLL_MS=3600000   # Interval (ms) to check for stale containers (default 3600000 = 1 hour):contentReference[oaicite:9]{index=9}
CLEANUP_STALE_MS=86400000 # Age (ms) after which containers are cleared (default 86400000 = 1 day):contentReference[oaicite:10]{index=10}
CONTAINER_URL_SCHEME=http # Scheme for container URLs (default "http"):contentReference[oaicite:11]{index=11}:contentReference[oaicite:12]{index=12}
PUBLIC_FQDN=              # Public hostname for container URLs (if not set, auto-detected):contentReference[oaicite:13]{index=13}
DEBUG=false               # Set "true" to enable verbose debug logs (e.g. for container file dumps):contentReference[oaicite:14]{index=14}:contentReference[oaicite:15]{index=15}

# Task/Build Tuning (optional):
MAX_WRITE_RETRIES=90   # Max polling retries for long-running tasks (default 90):contentReference[oaicite:16]{index=16}
POLL_INTERVAL_MS=2000  # Poll interval in ms for task status (default 2000ms):contentReference[oaicite:17]{index=17}
SPAWN_FLUSH_MS=750     # Flush interval for streaming output (default 750ms):contentReference[oaicite:18]{index=18}

# Docker Remote Daemon Settings (if using a remote Docker host):
DOCKER_HOST=            # e.g. tcp://remote-docker:2376 or ssh://user@remote (leave empty for local Docker)
DOCKER_TLS_VERIFY=      # set "1" to enable TLS verification if using DOCKER_HOST
DOCKER_CERT_PATH=       # path to Docker TLS certificates if needed for remote Docker
DOCKER_CLI_DEBUG=       # set "1" for verbose Docker CLI debugging (optional)
# (If DOCKER_HOST is unset, the server will use the local Docker socket by default)

# Container Image Overrides (optional):
SOLANAFLOW_BUILD_IMAGE=ghcr.io/sequence4/solana-toolchain:runtime-latest  # Custom runtime image for containers:contentReference[oaicite:19]{index=19}
#SF_HOST_PORT=3001       # (rarely used) Force a specific host port for containers instead of random
