# ── core settings ─────────────────────────────────────────────
PORT=9999
JWT_SECRET=your_jwt_secret_here
ROOT_FOLDER=/home/fox/projects/SolanaFlow/projects    
WALLETS_FOLDER=/home/fox/projects/SolanaFlow/wallets  
DATABASE_URL=postgres://user:password@host:5432/database_name
DOCKER_DEFAULT_PLATFORM=linux/amd64

# ── API keys / auth ───────────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BETA_CODE=YOUR_BETA_CODE

# ── cleanup & polling intervals (ms) ──────────────────────────
CLEANUP_POLL_MS=3600000
CLEANUP_STALE_MS=86400000
MAX_WRITE_RETRIES=90
POLL_INTERVAL_MS=2000
SPAWN_FLUSH_MS=750

# ── public URL construction ──────────────────────────────────
CONTAINER_URL_SCHEME=http
PUBLIC_FQDN=
DEBUG=false

# ── docker / container flags ─────────────────────────────────
DOCKER_HOST=
DOCKER_TLS_VERIFY=
DOCKER_CERT_PATH=
DOCKER_CLI_DEBUG=
FORCE_REMOTE_DOCKER=
DOCKER_SOCKET=
SOLANAFLOW_BUILD_IMAGE=
SF_DEV_SERVER=1
SF_DOCKER_PLATFORM=linux/amd64
SF_HOST_PORT=
