# Environment variables for SolanaFlow monorepo
#
# Copy this file to `.env` at the project root and fill in actual values.
# Docker Compose will automatically read the `.env` file when bringing up
# services, and the server loads variables from `server/.env`.

# ─── Docker Compose configuration ───────────────────────────────────────

# default CPU/OS for docker pull & build
DOCKER_DEFAULT_PLATFORM=linux/amd64

# PostgreSQL password used by docker-compose.db.yaml
PG_PASSWORD=

# Dapp identifier (used by compose.yaml).  Defaults to "demo".
APP_ID=demo

# When set to 1, connect to a remote Docker host specified by DOCKER_HOST.
# Leave unset or set to 0 to use the local UNIX socket.
FORCE_REMOTE_DOCKER=0

# Path to the Docker socket used when FORCE_REMOTE_DOCKER is not 1.
DOCKER_SOCKET=/var/run/docker.sock

# Remote Docker daemon (e.g. tcp://host:2376 or ssh://user@host).  Leave empty for local.
DOCKER_HOST=

# Flag used by dev scripts to enable dockerized server mode.
SF_DEV_SERVER=1

# GitHub Container Registry credentials (optional) for pulling/pushing images.
GHCR_PAT=
GHCR_USER=